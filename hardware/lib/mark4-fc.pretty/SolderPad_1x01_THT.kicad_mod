			(width 0.1)
			(type solid)
		)
		(fill no)
		(layer "F.Fab")
		(uuid "7a41f600-1000-4000-8000-000000000030")
	)

	(pad "1" thru_hole circle
		(at 0 0)
		(size 1.6 1.6)
		(drill 0.8)
		(layers "*.Cu" "*.Mask")
		(remove_unused_layers no)
		(uuid "7a41f600-1000-4000-8000-000000000040")
	)
	(embedded_fonts no)
)
