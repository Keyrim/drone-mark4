		)
		(uuid "65cf7ff2-7aaf-4be0-9711-3b40932ca246")
	)
	(text "J6 - ESC-3 4-in-1 ESC connector (pinout FROZEN by the spec)\n1 GND, 2 +12V, 3 M4, 4 M3, 5 M2, 6 M1, 7 CURR, 8 TLM"
