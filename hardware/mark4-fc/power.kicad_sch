	(text "5 V OR-ing (PWR-3)"
		(exclude_from_sim no)
		(at 124.46 53.34 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a2010415-0e6d-4da0-aa7e-9ab2c318adbc")
	)
	(text "U1 is the fixed 5 V version: FB is tied to the buck output (5V_BUCK)\nper the datasheet, and EN is tied to VIN (always on).\nOR stage: D1 also blocks the AP63205 high-side body diode, so USB\npower on the shared rail cannot back-feed the 12 V net (PWR-3)."
		(exclude_from_sim no)
		(at 40.64 105.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "beadd1b7-c763-4f87-b32a-3a41959924c1")
	)
