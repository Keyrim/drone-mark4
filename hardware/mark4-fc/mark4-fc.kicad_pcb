	(footprint "SolderPad_1x01_THT"
		(layer "F.Cu")
		(uuid "6f0c21d8-6fee-482b-ae36-b77d94fb72ba")
		(at 97.46 83.6 180)
		(descr "Single solder pad, one plated through-hole, 0.8 mm drill, 1.6 mm pad (0.4 mm annular ring). Not a connector and not an assembled part: the stripped wire is passed through the hole and soldered, so the barrel carries the mechanical load instead of a surface land. The hole is reachable and labelled from both faces, so the wire can be soldered from whichever side suits the build - which is also what makes a second row usable, the back row being soldered from below. This footprint replaces the 1xN pad groups (decided 2026-08-17): one instance per pad, placed freely, so external IO no longer reserves a fixed length of board edge. The silkscreen label is the component VALUE, so each instance names its own signal (TX1, M1, VBAT, ...); it is drawn vertically on BOTH faces so a long name does not run over the neighbouring pads. Courtyard is copper + 0.25 and deliberately excludes the label, as in the pad groups it supersedes: DRC will NOT protect label legibility, check it by eye. The reference designator and the value FIELD are both on F.Fab, not on the silkscreen: the only silkscreen text is the ${VALUE} label, because the signal name is what a wire needs and a refdes next to it would just collide with it (MEC-5). Board feature, kept out of the BOM and of the position file.")
		(tags "solder pad wire single through hole THT free placement dual sided silkscreen")
		(property "Reference" "J43"
			(at 0 2.7 180)
			(layer "F.Fab")
			(hide yes)
			(uuid "1692d98d-8ecc-4970-b31c-37902efc7276")
