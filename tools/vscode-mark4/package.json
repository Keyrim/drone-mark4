{
    "name": "vscode-mark4",
    "displayName": "Mark4",
    "description": "Bench tooling: build and run the apps, drive the bench, dock the hub pages in the editor.",
    "publisher": "tmagne",
    "version": "0.2.2",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.cjs",
    "scripts": {
        "gen": "mkdir -p src/gen && python3 -m grpc_tools.protoc -I ../../software/components/protocol --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=src/gen --es_opt=target=ts mark4.proto gateway.proto",
        "build": "pnpm gen && node esbuild.js",
        "watch": "pnpm gen && node esbuild.js --watch",
        "typecheck": "pnpm gen && tsc --noEmit",
        "test": "pnpm gen && node --import tsx --test test/*.test.ts",
        "smoke": "pnpm gen && node --import tsx scripts/smoke.ts",
        "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
    },
    "dependencies": {
        "@bufbuild/protobuf": "2.14.0",
        "ws": "8.21.3"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "2.14.0",
        "@types/node": "22.19.0",
        "@types/vscode": "1.100.0",
        "@types/ws": "8.18.1",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "0.25.12",
        "tsx": "4.20.6",
        "typescript": "5.9.3"
    },
    "contributes": {
        "languages": [
            {
                "id": "mark4-log",
                "aliases": [
                    "Mark4 log"
                ]
            }
        ],
        "grammars": [
            {
                "language": "mark4-log",
                "scopeName": "source.mark4-log",
                "path": "./syntaxes/mark4-log.tmLanguage.json"
            }
        ],
        "taskDefinitions": [
            {
                "type": "mark4",
                "properties": {
                    "action": {
                        "type": "string"
                    },
                    "app": {
                        "type": "string"
                    }
                }
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "mark4",
                    "title": "Mark4",
                    "icon": "media/mark4.svg"
                }
            ]
        },
        "views": {
            "mark4": [
                {
                    "id": "mark4.apps",
                    "name": "Apps"
                },
                {
                    "id": "mark4.nodes",
                    "name": "Nodes"
                },
                {
                    "id": "mark4.logLevels",
                    "name": "Log levels"
                },
                {
                    "id": "mark4.bench",
                    "name": "Bench"
                }
            ]
        },
        "commands": [
            {
                "command": "mark4.buildApp",
                "title": "Build App",
                "category": "Mark4",
                "icon": "$(tools)"
            },
            {
                "command": "mark4.runApp",
                "title": "Run App",
                "category": "Mark4",
                "icon": "$(play)"
            },
            {
                "command": "mark4.stopApp",
                "title": "Stop App",
                "category": "Mark4",
                "icon": "$(debug-stop)"
            },
            {
                "command": "mark4.debugApp",
                "title": "Debug App",
                "category": "Mark4",
                "icon": "$(debug-alt)"
            },
            {
                "command": "mark4.startHub",
                "title": "Start Hub",
                "category": "Mark4",
                "icon": "$(play)"
            },
            {
                "command": "mark4.stopHub",
                "title": "Stop Hub",
                "category": "Mark4",
                "icon": "$(debug-stop)"
            },
            {
                "command": "mark4.startGodot",
                "title": "Start Godot Sim",
                "category": "Mark4",
                "icon": "$(globe)"
            },
            {
                "command": "mark4.addDroneSim",
                "title": "Start One More drone_sim",
                "category": "Mark4",
                "icon": "$(add)"
            },
            {
                "command": "mark4.stopNode",
                "title": "Stop Node",
                "category": "Mark4",
                "icon": "$(debug-stop)"
            },
            {
                "command": "mark4.setLogLevel",
                "title": "Set level...",
                "category": "Mark4",
                "icon": "$(settings)"
            },
            {
                "command": "mark4.setLogLevelAll",
                "title": "Set level for everything...",
                "category": "Mark4",
                "icon": "$(settings)"
            },
            {
                "command": "mark4.resetLogLevels",
                "title": "Reset levels to INFO",
                "category": "Mark4",
                "icon": "$(discard)"
            },
            {
                "command": "mark4.toggleLogGrouping",
                "title": "Group By Node Or By Module",
                "category": "Mark4",
                "icon": "$(list-tree)"
            },
            {
                "command": "mark4.toggleLogVisibility",
                "title": "Hide / Show In Logs",
                "category": "Mark4",
                "icon": "$(eye)"
            },
            {
                "command": "mark4.searchLogs",
                "title": "Search Logs...",
                "category": "Mark4",
                "icon": "$(search)"
            },
            {
                "command": "mark4.clearLogs",
                "title": "Clear Logs",
                "category": "Mark4",
                "icon": "$(clear-all)"
            },
            {
                "command": "mark4.stopGodot",
                "title": "Stop Godot Sim",
                "category": "Mark4",
                "icon": "$(debug-stop)"
            },
            {
                "command": "mark4.openControl",
                "title": "Open Control Page",
                "category": "Mark4",
                "icon": "$(browser)"
            },
            {
                "command": "mark4.openPlots",
                "title": "Open Plots Page",
                "category": "Mark4",
                "icon": "$(graph-line)"
            },
            {
                "command": "mark4.benchSession",
                "title": "Bench Session",
                "category": "Mark4",
                "icon": "$(rocket)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "mark4.benchSession",
                    "when": "view == mark4.bench",
                    "group": "navigation"
                },
                {
                    "command": "mark4.addDroneSim",
                    "when": "view == mark4.nodes",
                    "group": "navigation@1"
                },
                {
                    "command": "mark4.startGodot",
                    "when": "view == mark4.nodes",
                    "group": "navigation@2"
                },
                {
                    "command": "mark4.setLogLevelAll",
                    "when": "view == mark4.logLevels",
                    "group": "navigation@1"
                },
                {
                    "command": "mark4.toggleLogGrouping",
                    "when": "view == mark4.logLevels",
                    "group": "navigation@2"
                },
                {
                    "command": "mark4.searchLogs",
                    "when": "view == mark4.logLevels",
                    "group": "navigation@3"
                },
                {
                    "command": "mark4.clearLogs",
                    "when": "view == mark4.logLevels",
                    "group": "navigation@4"
                }
            ],
            "view/item/context": [
                {
                    "command": "mark4.buildApp",
                    "when": "view == mark4.apps && viewItem =~ /^app/",
                    "group": "inline@1"
                },
                {
                    "command": "mark4.runApp",
                    "when": "view == mark4.apps && viewItem =~ /:run/",
                    "group": "inline@2"
                },
                {
                    "command": "mark4.stopApp",
                    "when": "view == mark4.apps && viewItem =~ /:stop/",
                    "group": "inline@2"
                },
                {
                    "command": "mark4.debugApp",
                    "when": "view == mark4.apps && viewItem =~ /:debug/",
                    "group": "inline@3"
                },
                {
                    "command": "mark4.startHub",
                    "when": "view == mark4.nodes && viewItem == gatewayDown",
                    "group": "inline"
                },
                {
                    "command": "mark4.stopNode",
                    "when": "view == mark4.nodes && viewItem =~ /:stop/",
                    "group": "inline"
                },
                {
                    "command": "mark4.setLogLevel",
                    "when": "view == mark4.logLevels && viewItem =~ /^logTarget/",
                    "group": "inline@1"
                },
                {
                    "command": "mark4.toggleLogVisibility",
                    "when": "view == mark4.logLevels && viewItem =~ /:node$/",
                    "group": "inline@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "mark4.buildApp",
                    "when": "false"
                },
                {
                    "command": "mark4.runApp",
                    "when": "false"
                },
                {
                    "command": "mark4.stopApp",
                    "when": "false"
                },
                {
                    "command": "mark4.debugApp",
                    "when": "false"
                },
                {
                    "command": "mark4.stopHub",
                    "when": "false"
                },
                {
                    "command": "mark4.stopGodot",
                    "when": "false"
                },
                {
                    "command": "mark4.stopNode",
                    "when": "false"
                },
                {
                    "command": "mark4.setLogLevel",
                    "when": "false"
                },
                {
                    "command": "mark4.toggleLogVisibility",
                    "when": "false"
                }
            ]
        }
    }
}
