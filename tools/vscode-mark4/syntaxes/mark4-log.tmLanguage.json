{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Mark4 log",
    "scopeName": "source.mark4-log",
    "patterns": [
        {
            "comment": "One log line as formatLogLine writes it: time, level, kind, node id, module, text, two spaces between fixed columns. The whole line takes one scope and the level alone picks it; INFO takes none and reads as the default foreground. A line that does not hold the layout matches nothing and stays uncolored.",
            "match": "^(\\d{2}:\\d{2}:\\d{2}\\.\\d{3}  (?:TRACE|DEBUG|INFO |WARN |ERROR)  .{9}  [0-9a-f]{8}  .{24}  .*)$",
            "captures": {
                "1": {
                    "patterns": [
                        {
                            "match": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}  ERROR  .*$",
                            "name": "invalid.illegal.line.error.mark4-log"
                        },
                        {
                            "match": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}  (?:WARN )  .*$",
                            "name": "string.unquoted.line.warn.mark4-log"
                        },
                        {
                            "match": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}  (?:TRACE|DEBUG)  .*$",
                            "name": "comment.line.mark4-log"
                        }
                    ]
                }
            }
        }
    ]
}
