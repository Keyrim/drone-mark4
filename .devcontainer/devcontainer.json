{
	"name": "drone-mark4",
	"dockerComposeFile": "docker-compose.yml",
	"service": "dev",
	"workspaceFolder": "/workspaces/drone-mark4",
	"remoteUser": "dev",

	// godot-tools LSP: the Godot editor runs on the HOST, its language
	// server listens on this TCP port.
	"forwardPorts": [6005],

	// WSL2 mirrored networking exposes the container ports on the Windows
	// localhost natively; VS Code auto-forwarding only duplicates them, and
	// a stale tunnel keeps the port reserved on the Windows side (seen on
	// the hub endpoint: bind failed with no visible listener).
	"otherPortsAttributes": {
		"onAutoForward": "ignore"
	},

	// Runs on the HOST before the container is created or started: exports
	// the session X11 cookie to the stable path compose bind-mounts as the
	// container's ~/.Xauthority (native X servers require it, WSLg does not).
	"initializeCommand": "bash .devcontainer/host-xauth.sh",

	// The named volumes (Claude/gh config) are created by the Docker daemon
	// (root): hand them back to the container user on first start.
	"postCreateCommand": "sudo chown -R dev:dev /home/dev/.claude /home/dev/.config/gh /home/dev/.gradle /home/dev/.pub-cache /home/dev/.android",

	// XDG_RUNTIME_DIR (forwarded by compose for WSLg) must exist in the
	// container: the VS Code server puts the `code` CLI IPC sockets there,
	// and without the directory the CLI cannot reach the server at all.
	"postStartCommand": "sudo install -d -m 700 -o dev -g dev /run/user/1000",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cmake-tools",
				"llvm-vs-code-extensions.vscode-clangd",
				"ms-vscode.cpptools",
				"marus25.cortex-debug",
				"ms-python.python",
				"geequlim.godot-tools",
				"Dart-Code.dart-code",
				"Dart-Code.flutter",
				"anthropic.claude-code",
				"mhutchie.git-graph"
			],
			"settings": {
				// WSL2 mirrored networking already exposes every container
				// port on the Windows localhost; the VS Code forwarder adds
				// nothing and its Windows-side listener leaks (vscode.exe
				// kept the hub port bound after the forward was stopped by
				// hand). So: never auto-forward, never restore old forwards.
				"remote.autoForwardPorts": false,
				"remote.restoreForwardedPorts": false,
				// clangd is the language server; cpptools is kept for its
				// desktop debugger (cppdbg) only; cortex-debug drives the
				// on-target sessions through JLinkGDBServer.
				"C_Cpp.intelliSenseEngine": "disabled",
				// Cross builds: clangd asks arm-none-eabi-g++ for its system
				// include paths and target defines instead of guessing from
				// the host clang.
				"clangd.arguments": [
					"--query-driver=/opt/arm-gnu-toolchain/bin/arm-none-eabi-*"
				]
			}
		}
	}
}
