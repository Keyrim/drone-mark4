{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "drone_sim (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/desktop/apps/drone_sim/drone_sim",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build drone_sim",
            "setupCommands": [
                {
                    "description": "Neutralize debuginfod: MIEngine force-enables it after setup commands and its downloads stall forever behind the container network, so the server list is emptied instead",
                    "text": "-gdb-set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "hub (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/desktop/apps/hub/hub",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build hub",
            "setupCommands": [
                {
                    "description": "Neutralize debuginfod: MIEngine force-enables it after setup commands and its downloads stall forever behind the container network, so the server list is emptied instead",
                    "text": "-gdb-set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "firmware (J-Link flash + debug)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "STM32F405RG",
            "interface": "swd",
            "executable": "${workspaceFolder}/build/stm32/apps/firmware/firmware.elf",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build firmware",
            "runToEntryPoint": "main"
        },
        {
            "name": "firmware (J-Link attach)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "jlink",
            "device": "STM32F405RG",
            "interface": "swd",
            "executable": "${workspaceFolder}/build/stm32/apps/firmware/firmware.elf",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "sim_stub (python)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/sim-stub/sim_stub.py",
            "args": [
                "--duration",
                "0"
            ],
            "console": "integratedTerminal"
        }
    ]
}
