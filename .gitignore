# Build
build/
CMakeUserPresets.json
compile_commands.json
.cache/

# Flight / telemetry logs
logs/*
!logs/.gitkeep

# Wifi credentials of whoever builds the bridge, never the repository's
esp32-bridge/local.cmake

# Python
__pycache__/
*.pyc
.venv/

# Editors
.vscode/*
!.vscode/tasks.json

# pnpm side-effect store (pages toolchain)
.pnpm-store/

# ESP-IDF (only sdkconfig.defaults is tracked)
esp32-bridge/build/
esp32-bridge/sdkconfig
esp32-bridge/sdkconfig.old

# Scratch (handoffs, reference clones)
tmp/

# Codecs generated from software/components/protocol/mark4.proto by the desktop build
sim-godot/scripts/gen/
# TypeScript codecs generated by `pnpm gen` in software/hub/pages (protoc-gen-es)
software/hub/pages/src/gen/
# Godot user data written next to the project by a headless run
sim-godot/godot/

# Git worktrees: home for `git worktree add worktrees/<name>` checkouts, so
# they live inside the clone (bind-mounted into the container) without ever
# showing up as untracked content. The README explains the workflow and stays
# tracked, which also keeps the directory present after a fresh clone.
/worktrees/*
!/worktrees/README.md
# Claude Code's built-in worktree feature puts its checkouts here instead;
# ignored so a stray one does no harm. worktrees/README.md has the convention.
.claude/worktrees/
