# nanopb bounds for gateway.proto: the hub is the only C++ consumer and it
# is a desktop process, so the bounds are generous rather than tight. Every
# enum gets a fixed 32-bit underlying type like mark4.options does.

*                                   enum_intsize:IS_32

mark4.Node.address                  max_size:16
mark4.NodeTable.nodes               max_count:33

# One node's whole telemetry table (the drone side freezes at most
# MAX_TELEMETRY_ENTRIES = 128 entries). This is why it is not a Node field:
# 128 x 33 nodes inside NodeTable would not fit nanopb's 16-bit field
# offsets at all, and would cost every GatewayMessage variable a few
# hundred kB.
mark4.NodeTelemetry.descriptors     max_count:128

# The module table of one node, what its LogConsumer keeps.
mark4.NodeLogModules.modules        max_count:32
# The line ring the gateway keeps per node, sent whole to a client that
# connects. The largest member of the union, and what sizes it.
mark4.NodeLogLines.lines            max_count:256
mark4.NodeTelemetryConfig.ids       max_count:64
mark4.NodeTuning.infos              max_count:64

# One node's view of the wire: one rate per declared link, one edge per
# peer of its transport table, and one verdict per node of the table.
mark4.NodeTransport.links           max_count:4
mark4.NodeTransport.edges           max_count:32
mark4.TransportHealth.nodes         max_count:33

mark4.TelemetryConfigRequest.ids    max_count:64

mark4.OtaCommand.bundle_path        max_size:256

mark4.OtaState.verdict_text         max_size:160
mark4.OtaState.last_error           max_size:160
mark4.OtaState.Bundle.path          max_size:256
mark4.OtaState.Bundle.name          max_size:33
mark4.OtaState.Bundle.git_hash      max_size:9
mark4.OtaState.Bundle.wire_hash     max_size:9
mark4.OtaState.Board.slots          max_count:2

mark4.ProfileCommand.name           max_size:33
mark4.ProfileCommand.values         max_count:64
mark4.ProfileList.names             max_count:32 max_size:33
mark4.Profile.name                  max_size:33
mark4.Profile.values                max_count:64

mark4.Ack.error                     max_size:160
