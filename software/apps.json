{
    "apps": [
        {
            "name": "drone_sim",
            "cmakePreset": "desktop",
            "target": "drone_sim",
            "run": ["software/build/desktop/drone_sim/drone_sim"]
        },
        {
            "name": "hub",
            "cmakePreset": "desktop",
            "target": "hub",
            "run": ["software/build/desktop/hub/hub"]
        },
        {
            "name": "drone_replay",
            "cmakePreset": "desktop",
            "target": "drone_replay"
        },
        {
            "name": "drone_firmware",
            "cmakePreset": "stm32",
            "target": "drone_firmware"
        },
        {
            "name": "tests",
            "cmakePreset": "desktop",
            "target": "unit_tests",
            "run": ["ctest", "--test-dir", "software/build/desktop", "--output-on-failure"]
        },
        {
            "name": "tests_san",
            "cmakePreset": "desktop-san",
            "target": "unit_tests",
            "run": ["ctest", "--test-dir", "software/build/desktop-san", "--output-on-failure"]
        }
    ]
}
